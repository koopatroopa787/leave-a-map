# Cloud site only (apps/cloud). The scan site never receives Firebase config.
# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
VITE_CLOUD_FIREBASE_API_KEY=
VITE_CLOUD_FIREBASE_AUTH_DOMAIN=
VITE_CLOUD_FIREBASE_PROJECT_ID=
VITE_CLOUD_FIREBASE_APP_ID=
# App Check > Apps > reCAPTCHA Enterprise site key.
VITE_CLOUD_RECAPTCHA_SITE_KEY=
# App Check debug token: put it in .env.debug (git-ignored), never here, and run
# `npm run dev:cloud -- --mode debug`. Production builds ignore it.
# Which Gemini tier the cloud lookup runs on. Leave unset and a production build shows "not
# switched on yet" in the consent window and looks nothing up. paid-tier-on once billing is on;
# free-tier-on for the free tier (free-terms notice, a required not-in-EEA/CH/UK box, no health
# or money rows, at most 10 per lookup). Both sites read it, so build both with the same value.
# VITE_CLOUD_LOOKUP=paid-tier-on
# VITE_CLOUD_LOOKUP=free-tier-on
